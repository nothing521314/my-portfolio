# ============================================================
#  ENVIRONMENT TEMPLATE — copy thành .env trên server
#  cp .env.example .env  rồi điền giá trị thật vào
# ============================================================

# ----- Telegram Bot (Contact Form) -------------------------
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID nhận thông báo (ID cá nhân hoặc group)
# Lấy ID cá nhân: nhắn tin cho @userinfobot
TELEGRAM_CHAT_ID=

# ----- Next.js Runtime -------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
